# Copie este arquivo para .env (na raiz) e preencha. O .env nunca vai para o Git.

# --- Postgres (usados pelo serviço postgres do Compose e para montar a DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=miolo_e_mel

# --- Rodando fora do Docker (pnpm dev): os serviços estão em localhost
DATABASE_URL=
REDIS_URL=

# --- Firebase 
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Segredo: JSON da conta de serviço, em base64 (ou o caminho do arquivo)
FIREBASE_SERVICE_ACCOUNT_JSON=

#CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"